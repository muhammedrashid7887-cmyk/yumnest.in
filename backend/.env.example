# Yumnest Express Backend Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
PORT=4000

# Database Connection URI
# Option A (Local MongoDB): mongodb://127.0.0.1:27017/yumnest
# Option B (Shared MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/yumnest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/yumnest

# Frontend Origin for CORS & Session Cookies
FRONTEND_ORIGIN=http://localhost:3000

# Admin Session Configuration
SESSION_COOKIE_NAME=yumnest_admin_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Optional Initial Owner Credentials (used by `npm run create-admin` in non-interactive/CI setups)
# ADMIN_NAME=Admin User
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Min12CharactersSecurePassword!

# Optional Cloudinary Media Storage (leave blank if not using live upload in local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

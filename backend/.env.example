# ==============================================================================
# Yumnest Express Backend Environment Configuration
# ==============================================================================
# Local Development: Copy this file to `backend/.env`
# Render Deployment: Configure these in the Render Dashboard Environment tab
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=10000

# Database Connection URI (MongoDB Atlas recommended for Render)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/yumnest?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yumnest?retryWrites=true&w=majority

# Allowed Frontend Origins for CORS & Session Cookies
# Separate multiple origins with commas (e.g. your Render frontend and custom domain)
FRONTEND_ORIGIN=https://yumnest-frontend.onrender.com,https://yumnest.in

# Session & Security Settings
SESSION_COOKIE_NAME=yumnest_admin_session
SESSION_TTL_DAYS=7

# Set to true in production (required on Render with HTTPS)
SESSION_COOKIE_SECURE=true

# Use "none" for cross-origin setups (when backend and frontend have different .onrender.com URLs)
# Use "lax" if both frontend and backend are hosted under the same root domain (e.g. api.yumnest.in and yumnest.in)
SESSION_COOKIE_SAME_SITE=none

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Cloudinary Media Storage (Required for product & category image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Account Seed (Optional: used on initial boot if no admin exists)
ADMIN_NAME=Admin Owner
ADMIN_EMAIL=admin@yumnest.in
ADMIN_PASSWORD=YourStrongPasswordHere!

# Media Auto-Fetch Integration (Optional)
# YOUTUBE_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=

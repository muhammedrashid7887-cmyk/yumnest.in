{
  "name": "yumnest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Yumnest Express API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "seed:products": "tsx src/scripts/seed-storefront-products.ts",
    "test:e2e-auth": "tsx src/scripts/test-complete-auth-flow.ts",
    "test:verify-auth": "tsx src/scripts/verify-auth-mongodb.ts",
    "test:integration": "tsx src/scripts/verify-full-integration.ts",
    "test:auth": "npm run build && node dist/utils/auth-crypto.test.js",
    "test:catalogue": "npm run build && node dist/utils/catalogue-validation.test.js",
    "test:media": "npm run build && node dist/utils/media-validation.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

# ==============================================================================
# Yumnest Next.js Frontend Environment Configuration
# ==============================================================================
# Local Development: Copy this file to `frontend/.env.local`
# Render Deployment: Set NEXT_PUBLIC_API_URL in Render Dashboard Environment tab
# ==============================================================================

# URL of the deployed Yumnest Express backend service
# Local default: http://localhost:4000
# Render production: https://yumnest-backend.onrender.com (or your custom backend domain)
NEXT_PUBLIC_API_URL=https://yumnest-backend.onrender.com
